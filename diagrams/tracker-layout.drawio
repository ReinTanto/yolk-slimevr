        <mxCell id="legend_title" value="Layout notes" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="215" y="455" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend1" value="• Battery bay: recessed slot along the long axis (523450: 52×34×5 mm), JST-PH socket on the access side" style="text;html=1;align=left;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="215" y="480" width="670" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend2" value="• Electronics (D1 Mini, IMU, power board) stacked on one side of the battery to keep the case slim" style="text;html=1;align=left;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="215" y="502" width="670" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend3" value="• I²C: D1 D2=GPIO4 (SDA), D1=GPIO5 (SCL) → GY-LSM6DS3; confirm the D1 Mini silkscreen" style="text;html=1;align=left;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="215" y="524" width="670" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend4" value="• TP4056 MT3608 board: set output to 5.0 V (measure under load); USB micro for charging" style="text;html=1;align=left;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="215" y="546" width="670" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend5" value="• Slide switch in series with the battery line; strap channel runs the full length of the case" style="text;html=1;align=left;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="215" y="568" width="670" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend6" value="• Rounded edges; 0.2 mm clearance per side on the D1 Mini fit; LED window over the D1 Mini status LED" style="text;html=1;align=left;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="215" y="590" width="670" height="20" as="geometry" />
