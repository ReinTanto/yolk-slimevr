        </mxCell>
        <mxCell id="imu_scl" value="SCL" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="710" y="365" width="40" height="16" as="geometry" />
        </mxCell>

        <!-- ===== EDGES ===== -->

        <!-- USB micro -> Shield VIN/GND -->
        <mxCell id="e_usb_shield" value="VIN / GND" style="edgeStyle=none;html=1;strokeColor=#9673a6;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="usb_micro" target="shield">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Shield 5V -> D1 5V -->
        <mxCell id="e_shield_d1_5v" value="5V" style="edgeStyle=none;html=1;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.25;exitY=1;entryX=0.25;entryY=0;fontSize=10;" edge="1" parent="1" source="shield" target="d1">
          <mxGeometry relative="1" as="geometry" />
