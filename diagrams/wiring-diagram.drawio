        <!-- ===== STACK LAYOUT INDICATOR ===== -->
        <mxCell id="stack_label" value="STACKED LAYOUT (top → bottom)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333" vertex="1" parent="1">
