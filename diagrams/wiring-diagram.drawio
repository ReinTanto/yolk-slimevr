        <!-- D1 D2 SDA -> IMU SDA -->
        <mxCell id="e_d1_imu_sda" value="SDA" style="edgeStyle=none;html=1;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.7;entryX=0;entryY=0.7;fontSize=10;" edge="1" parent="1" source="d1" target="imu">
          <mxGeometry relative="1" as="geometry" />
