        </mxCell>
        <mxCell id="d1_gnd" value="GND" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="360" y="265" width="40" height="16" as="geometry" />
        </mxCell>
        <mxCell id="d1_3v3" value="3V3" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="360" y="285" width="40" height="16" as="geometry" />
        </mxCell>
        <mxCell id="d1_d2" value="D2 (GPIO4) SDA" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="360" y="305" width="120" height="16" as="geometry" />
