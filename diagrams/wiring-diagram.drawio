        <!-- D1 D1 SCL -> IMU SCL -->
        <mxCell id="e_d1_imu_scl" value="SCL" style="edgeStyle=none;html=1;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.9;entryX=0;entryY=0.9;fontSize=10;" edge="1" parent="1" source="d1" target="imu">
