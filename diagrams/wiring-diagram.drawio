        <!-- Shield GND -> Toggle Switch -->
        <mxCell id="e_shield_sw" value="GND" style="edgeStyle=none;html=1;strokeColor=#b85450;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.3;fontSize=10;" edge="1" parent="1" source="shield" target="switch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Toggle Switch -> D1 GND -->
        <mxCell id="e_sw_d1" value="GND" style="edgeStyle=none;html=1;strokeColor=#b85450;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.75;entryY=0;fontSize=10;" edge="1" parent="1" source="switch" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Battery -> Shield B+/B- (directly soldered) -->
        <mxCell id="e_batt_shield" value="B+ / B−&#10;(soldered directly)" style="edgeStyle=none;html=1;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=0;entryX=0.5;entryY=1;fontSize=10;" edge="1" parent="1" source="batt" target="shield">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="490" y="350" />
              <mxPoint x="200" y="350" />
              <mxPoint x="200" y="140" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- USB Type-C -> D1 (flashing) -->
        <mxCell id="e_typec_d1" value="flashing" style="edgeStyle=none;html=1;strokeColor=#9673a6;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="usb_typec" target="d1">
          <mxGeometry relative="1" as="geometry" />
