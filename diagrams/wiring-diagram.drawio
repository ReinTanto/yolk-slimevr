        </mxCell>
        <mxCell id="batt_note" value="wires soldered directly to shield B+/B−" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="350" y="460" width="280" height="16" as="geometry" />
