        <mxCell id="legend_title" value="Legend / Notes" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="95" y="505" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend1" value="• Stacked layout: TOP = Battery Shield (TP4056), MIDDLE = D1 Mini, BOTTOM = Battery (skin-facing)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="95" y="530" width="480" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend2" value="• Toggle switch: between D1 GND and Shield GND, offset sideways, accessible from outside" style="text;html=1;align=left;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="95" y="552" width="480" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend3" value="• Battery: built-in 2000 mAh LiPo (D1 Mini size), wires soldered directly to shield B+/B− (no JST-PH)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="95" y="574" width="480" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend4" value="• USB micro (on shield) = charging; USB Type-C (on D1 Mini) = flashing only" style="text;html=1;align=left;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="95" y="596" width="480" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend5" value="• I²C: D1 D2=GPIO4 (SDA), D1=GPIO5 (SCL) → GY-LSM6DS3 (soldered on D1 backside)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="95" y="618" width="480" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend6" value="• GY-LSM6DS3: I²C addr 0x69 (SDO→VCC) or 0x6A (SDO→GND) — confirm SDO pin" style="text;html=1;align=left;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="95" y="640" width="480" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend7" value="• Both USB ports (charging + D1) accessible from outside the case" style="text;html=1;align=left;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="95" y="662" width="480" height="20" as="geometry" />
        </mxCell>

