        <!-- D1 3V3 -> IMU VCC -->
        <mxCell id="e_d1_imu_vcc" value="3V3" style="edgeStyle=none;html=1;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.3;entryX=0;entryY=0.3;fontSize=10;" edge="1" parent="1" source="d1" target="imu">
