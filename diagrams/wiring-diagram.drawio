        <mxCell id="imu_gnd" value="GND" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="710" y="325" width="40" height="16" as="geometry" />
        </mxCell>
        <mxCell id="imu_sda" value="SDA" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#82b366" vertex="1" parent="1">
