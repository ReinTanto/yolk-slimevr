<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="yolk-slimevr" version="24.7.7">
  <diagram id="yolk-wiring" name="Tracker Wiring">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="yolk-slimevr — Per-Tracker Wiring Diagram" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Wemos D1 Mini + D1 Battery Shield + GY-LSM6DS3 + Built-in LiPo (2000 mAh)" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666" vertex="1" parent="1">
          <mxGeometry x="280" y="50" width="600" height="20" as="geometry" />
        </mxCell>

        <!-- ===== STACKED LAYOUT (top to bottom) ===== -->

        <!-- TOP: Battery Shield (with TP4056 charger) -->
        <mxCell id="shield" value="D1 Mini Battery Shield&#10;(TP4056 charger + 5mm coil)&#10;[TOP LAYER]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="350" y="100" width="280" height="80" as="geometry" />
