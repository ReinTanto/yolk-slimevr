        </mxCell>
        <mxCell id="shield_vin" value="VIN / GND (USB micro)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="360" y="125" width="140" height="16" as="geometry" />
        </mxCell>
        <mxCell id="shield_5v" value="5V out" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="360" y="145" width="60" height="16" as="geometry" />
        </mxCell>
        <mxCell id="shield_gnd" value="GND out" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="360" y="165" width="60" height="16" as="geometry" />
        </mxCell>

        <!-- USB micro (charging, on shield) -->
        <mxCell id="usb_micro" value="USB micro&#10;(charging — on shield)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- USB Type-C (on D1 Mini) -->
        <mxCell id="usb_typec" value="USB Type-C&#10;(flashing — on D1 Mini)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="80" y="250" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- MIDDLE: D1 Mini -->
        <mxCell id="d1" value="Wemos D1 Mini&#10;(ESP8266)&#10;[MIDDLE LAYER]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="350" y="240" width="280" height="80" as="geometry" />
