        <!-- IMU (soldered on backside of D1) -->
        <mxCell id="imu" value="GY-LSM6DS3&#10;(LSM6DS3TR-C + e-compass)&#10;soldered on D1 backside [I²C]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1">
